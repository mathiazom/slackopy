---
import {renderMessageText} from "../lib/renderMessageText";
import {groupMessages} from "../lib/groupMessages";
import {latestAnchorId} from "../lib/channelUrl";
import MessageGroup, {type MessageResponse} from "./MessageGroup.astro";

const {channelId} = Astro.props;

const backendUrl = process.env.BACKEND_URL;

const response = await fetch(`${backendUrl}/channels/${channelId}`);

type ChannelResponse = {
    channel: { id: string; name: string; topic: string | null };
    messages: MessageResponse[];
};

if (!response.ok) {
    throw new Error(`Fetching channel ${channelId} failed: ${response.status}`);
}
const data = await response.json() as ChannelResponse;
---

<style>
    /* The page's own gutters replace the body margin, so the banner can span
       the full width and has no gap above it (it sticks as soon as scrolling
       starts). Only bundled on pages that render a channel. */
    :global(body) {
        margin: 0;
    }

    /* A search hit's matched word (see the script below), in <mark>'s colors. */
    :global(::highlight(search)) {
        background-color: Mark;
        color: MarkText;
    }

    .banner, .list {
        padding-inline: 8px;
    }

    .list {
        margin: 0;
    }

    /* Messages are chronological and the page opens scrolled to the bottom, like
       Slack, so the channel name and topic stay pinned above them. Thicker than
       the message borders so the two don't read as the same kind of edge. */
    .banner {
        position: sticky;
        top: 0;
        z-index: 1;
        background: white;
        padding-block: 0.5rem;
        border-bottom: 3px solid black;
    }

    .channelName {
        container-type: inline-size;
    }

    .channelName h1 {
        font-size: min(1.5em, calc(100cqw / (var(--chars) * 0.6)));
        white-space: nowrap;
        overflow: hidden;
        margin-block: 0.25em;
    }

    /* Without a topic below it, the name's bottom margin would stack on the
       banner's own padding. */
    .channelName:last-child h1 {
        margin-block-end: 0;
    }

    /* Links to a channel carry #latest (see channelHref). For bare URLs,
       browsers that support it (Chromium) start at the anchor anyway; others
       open at the top. */
    .latest {
        scroll-initial-target: nearest;
    }

    /* Kept to one line so a long topic can't take over the viewport. */
    .topic {
        overflow-wrap: anywhere;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 1;
        line-clamp: 1;
        overflow: hidden;
    }

    /* Mentions come from renderMessageText via set:html, so they're outside
       this component's scoped styles. Colors follow Slack's own. */
    :global(.mention) {
        padding-inline: 2px;
        border-radius: 3px;
        background: rgba(29, 155, 209, 0.1);
        color: #1264a3;
        text-decoration: none;
    }

    :global(a.mention:hover) {
        background: rgba(29, 155, 209, 0.2);
    }

    :global(.mention--special) {
        background: rgba(242, 199, 68, 0.4);
        color: inherit;
    }
</style>

<header class="banner">
    <a href="/">&larr; kanaler</a>
    <div class="channelName">
        <h1 style={`--chars: ${data.channel.name.length + 1}`}>#{data.channel.name}</h1>
    </div>
    {data.channel.topic && <div class="topic" set:html={renderMessageText(data.channel.topic)}/>}
</header>
<div class="list" data-pagefind-body>
    {groupMessages(data.messages).map((group) => <MessageGroup messages={group}/>)}
</div>
<div id={latestAnchorId} class="latest"/>

<script>
    // Search hits link here with the message group's header id in ?group= and
    // the matched word in ?hl= (see search.astro). Query parameters rather than a
    // #fragment or text fragment, so the browser doesn't jump on its own:
    // Firefox lands those unreliably on long pages, so this is the only scroll.
    const params = new URLSearchParams(location.search);
    const header = document.getElementById(params.get("group") ?? "");
    const word = params.get("hl");
    const navigation = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
    // Going back or forward restores where the reader was instead.
    if (header && navigation?.type !== "back_forward") {
        for (let details = header.closest("details"); details; details = details.parentElement!.closest("details")) {
            details.open = true;
        }
        const range = word ? findWord(header.closest(".group")!, word) : null;
        if (range && "highlights" in CSS) {
            CSS.highlights.set("search", new Highlight(range));
        }
        const target = range?.startContainer.parentElement ?? header;
        // Once the font and layout have settled, so the position holds.
        const loaded = document.readyState === "complete"
            ? Promise.resolve()
            : new Promise((resolve) => addEventListener("load", resolve, {once: true}));
        Promise.all([loaded, document.fonts.ready]).then(() => {
            target.scrollIntoView({block: "center"});
        });
    }

    // The word is the page's own text from the search index, so an exact match;
    // failing that, without surrounding punctuation, which the index keeps
    // attached but the page may split into another element (e.g. after a mention).
    function findWord(root: Element, word: string): Range | null {
        for (const needle of [word, word.replace(/^[^\p{L}\p{N}]+|[^\p{L}\p{N}]+$/gu, "")]) {
            if (!needle) continue;
            const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
                // Not in reactions, whose popover text is hidden (and not indexed).
                acceptNode: (node) => node.parentElement?.closest("[data-pagefind-ignore]")
                    ? NodeFilter.FILTER_REJECT
                    : NodeFilter.FILTER_ACCEPT,
            });
            for (let node = walker.nextNode(); node; node = walker.nextNode()) {
                const index = (node as Text).data.indexOf(needle);
                if (index === -1) continue;
                const range = document.createRange();
                range.setStart(node, index);
                range.setEnd(node, index + needle.length);
                return range;
            }
        }
        return null;
    }
</script>

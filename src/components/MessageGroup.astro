---
import {renderMessageText} from "../lib/renderMessageText";
import {groupMessages} from "../lib/groupMessages";
import Avatar from "./Avatar.astro";
import Reactions, {type ReactionResponse} from "./Reactions.astro";

type FileResponse = {
    id: string;
    name: string | null;
    mimetype: string | null;
    // The archived original.
    url: string;
    // What to show inline (the original, or a browser-friendly copy of it, e.g.
    // JPEG for HEIC); null when the file is only linked.
    imageUrl: string | null;
    // Dimensions of imageUrl's image.
    width: number | null;
    height: number | null;
};

export type MessageResponse = {
    id: string;
    text: string | null;
    authorDisplayName: string;
    authorRealName: string;
    authorId: string | null;
    authorSnapshotId: number | null;
    authorAvatarUrl: string | null;
    authorAvatarLargeUrl: string | null;
    timestamp: string;
    files: FileResponse[];
    reactions: ReactionResponse[];
    replies: MessageResponse[];
};

type Props = {
    // Consecutive messages from one author identity, chronological (see groupMessages).
    messages: MessageResponse[];
};

const {messages} = Astro.props;
const author = messages[0];

function renderTimestamp(timestamp: string) {
    return new Date(timestamp).toLocaleString(new Intl.Locale('no'))
}

// Matches the .image max size. Rendering images at their final size up front
// means the page has its full height before any image loads, so opening at
// #latest isn't thrown off by images arriving afterwards.
const MAX_IMAGE_WIDTH = 480;
const MAX_IMAGE_HEIGHT = 360;

function imageSize(file: FileResponse) {
    if (!file.width || !file.height) return {};
    const scale = Math.min(1, MAX_IMAGE_WIDTH / file.width, MAX_IMAGE_HEIGHT / file.height);
    return {width: Math.round(file.width * scale), height: Math.round(file.height * scale)};
}
---

<style>
    .group {
        /* Avatar column, shared with Avatar.astro and the thread offset below. */
        --avatar-size: 38px;
        --avatar-gap: 0.75rem;
        display: flex;
        gap: var(--avatar-gap);
        border: 1px solid black;
        margin: 0.5rem 0;
        padding: 1rem;
        overflow-wrap: anywhere;
    }

    .content {
        flex: 1;
        min-width: 0;
    }

    .header {
        margin: 0;
    }

    .timestamp {
        color: var(--color-secondary);
    }

    /* Non-breaking space so the dot never ends a line on its own. */
    .timestamp::before {
        content: "·\00a0";
    }

    .message + .message {
        margin-block-start: 1rem;
    }

    /* Rendered message text can contain <blockquote>/<pre>, which a <p> can't
       hold, so these are <div>s with a <p>'s default margins. */
    .text {
        margin-block: 0.25em 0.5em;
    }

    .files {
        margin-block: 0.5rem 1rem;
        display: flex;
        flex-wrap: wrap;
        /* Images of different heights would otherwise stretch to the row. */
        align-items: flex-start;
        gap: 1rem;
    }

    /* Capped in both directions, keeping the aspect ratio, so a tall
       screenshot doesn't take over the channel (Slack caps around the same).
       Images with known dimensions already get their capped size as
       width/height attributes (see imageSize); height: auto keeps the ratio
       when 100% is narrower. Images without get capped from their natural size. */
    /* Opens the original, which for a converted image (e.g. HEIC) is the file
       as uploaded rather than the copy shown. */
    .image-link {
        display: block;
        max-width: 100%;
        line-height: 0;
    }

    .image {
        max-width: min(100%, 480px);
        max-height: 360px;
        height: auto;
        border: 1px solid black;
    }

    .thread__header {
        margin-block: 1rem;
    }

    /* .content is a flex item, so trailing margins don't collapse into the
       group's padding and would add to it. Spacing between messages comes from
       .message + .message instead. */
    .message > :global(:last-child),
    .text > :global(:last-child),
    details:not([open]) > .thread__header,
    .thread > .group:last-child {
        margin-block-end: 0;
    }

    .thread :global(.group) {
        border-left: 0.5rem solid black;
    }

    /* Replies line up under the parent's avatar instead of its text, so nested
       threads don't lose a column of width per level. Each reply keeps its own
       avatar column inside its box. */
    .thread {
        margin-inline-start: calc(-1 * (var(--avatar-size) + var(--avatar-gap)));
    }
</style>

<div class="group">
    <Avatar url={author.authorAvatarUrl} largeUrl={author.authorAvatarLargeUrl}
            colorKey={author.authorId ?? author.authorDisplayName} name={author.authorDisplayName}/>
    <div class="content">
        <p class="header">
            <b title={author.authorRealName}>{author.authorDisplayName}</b>
            <time class="timestamp" datetime={author.timestamp}>{renderTimestamp(author.timestamp)}</time>
        </p>
        {messages.map((message) => (
            <div class="message">
                {message.text && <div class="text" set:html={renderMessageText(message.text)}/>}
                {message.files.length > 0 && (
                    <div class="files">
                        {message.files.map((file) => (
                            file.imageUrl ? (
                                <a href={file.url} target="_blank" rel="noopener noreferrer" class="image-link">
                                    <img src={file.imageUrl} alt={file.name ?? ""} class="image" {...imageSize(file)}/>
                                </a>
                            ) : (
                                <a href={file.url} target="_blank" rel="noopener noreferrer">
                                    {file.name ?? file.id}
                                </a>
                            )
                        ))}
                    </div>
                )}
                <Reactions messageId={message.id} reactions={message.reactions}/>
                {message.replies.length > 0 && (
                    <details>
                        <summary class="thread__header">
                            {message.replies.length} svar
                        </summary>
                        <div class="thread">
                            {groupMessages(message.replies).map((group) => (
                                <Astro.self messages={group}/>
                            ))}
                        </div>
                    </details>
                )}
            </div>
        ))}
    </div>
</div>

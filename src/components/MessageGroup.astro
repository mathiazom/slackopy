---
import {renderMessageText} from "../lib/renderMessageText";
import {groupMessages} from "../lib/groupMessages";
import {idSafe} from "../lib/channelUrl";
import {profilePopoverId} from "../lib/userProfile";
import Avatar from "./Avatar.astro";
import Reactions, {type ReactionResponse} from "./Reactions.astro";

type FileResponse = {
    id: string;
    name: string | null;
    mimetype: string | null;
    // The archived original.
    url: string;
    // How to show the file inline; null when it's only linked.
    embed: EmbedResponse | null;
};

type EmbedResponse = {
    kind: "image" | "video" | "audio";
    // For large images Slack's thumbnail; otherwise the original, or a
    // browser-friendly copy of it (e.g. JPEG for HEIC).
    url: string;
    // Dimensions of the image or video, null when unknown (always for audio).
    width: number | null;
    height: number | null;
    // For video, a still frame to show before it plays.
    posterUrl: string | null;
};

export type MessageResponse = {
    id: string;
    text: string | null;
    authorDisplayName: string;
    authorRealName: string;
    authorId: string | null;
    // Also keys the author's profile in the channel's users.
    authorProfileId: number | null;
    authorAvatarUrl: string | null;
    timestamp: string;
    files: FileResponse[];
    reactions: ReactionResponse[];
    replies: MessageResponse[];
};

type Props = {
    // Consecutive messages from one author identity, chronological (see groupMessages).
    messages: MessageResponse[];
    inThread?: boolean;
};

const {messages, inThread = false} = Astro.props;
const author = messages[0];

// The header is a heading with an id so search can link to the group: Pagefind
// splits a channel into one sub-result per heading. Replies nest under the
// channel's h1 one level deeper than top-level messages.
const Header = inThread ? "h3" : "h2";
const headerId = `message-${idSafe(author.id)}`;
// Bot/system messages without a user have no profile.
const profilePopover = author.authorId !== null && author.authorProfileId !== null
    ? profilePopoverId(author.authorProfileId)
    : undefined;

function renderTimestamp(timestamp: string) {
    return new Date(timestamp).toLocaleString(new Intl.Locale('no'))
}

// Matches the .video max size and caps the image row. Rendering images and
// videos at their final size up front means the page has its full height before
// any of them load, so opening at #latest isn't thrown off by media arriving
// afterwards. It's also what makes lazy-loading images safe.
const MAX_MEDIA_WIDTH = 480;
const MAX_MEDIA_HEIGHT = 360;
// Below this the image row scrolls instead of shrinking.
const MIN_IMAGE_ROW_HEIGHT = 140;

function mediaSize(embed: EmbedResponse) {
    if (!embed.width || !embed.height) return {};
    const scale = Math.min(1, MAX_MEDIA_WIDTH / embed.width, MAX_MEDIA_HEIGHT / embed.height);
    return {width: Math.round(embed.width * scale), height: Math.round(embed.height * scale)};
}

// A message's images share one height. Each grows by its aspect ratio, so the
// height is the row's width over the ratio sum, and bounding the width (see
// .image-row__track) bounds the height. Without known dimensions an image gets
// a square slot and is letterboxed in it.
function imageRow(files: FileResponse[]) {
    const images = files.flatMap(({url, name, embed}) => {
        if (embed?.kind !== "image") return [];
        const ratio = embed.width && embed.height ? embed.width / embed.height : null;
        return [{url, name, src: embed.url, height: embed.height, ratio: ratio ?? 1, letterboxed: ratio === null}];
    });
    if (images.length === 0) return null;

    const ratioSum = images.reduce((sum, image) => sum + image.ratio, 0);
    // Not scaled up past the smallest image, and a lone one keeps the width cap.
    let maxHeight = Math.min(MAX_MEDIA_HEIGHT, ...images.map((image) => image.height ?? Infinity));
    if (images.length === 1) maxHeight = Math.min(maxHeight, MAX_MEDIA_WIDTH / ratioSum);
    return {
        images,
        style: {
            "--ratio-sum": ratioSum,
            "--gaps": images.length - 1,
            "--max-height": `${maxHeight}px`,
            "--min-height": `${Math.min(MIN_IMAGE_ROW_HEIGHT, maxHeight)}px`,
        },
    };
}

// With a poster nothing of the video needs loading before it plays; without one,
// its metadata gives the browser a first frame to show (where it can decode it).
function videoPreview(embed: EmbedResponse) {
    return embed.posterUrl ? {poster: embed.posterUrl, preload: "none"} : {preload: "metadata"};
}
---

<style>
    .group {
        /* Avatar column, shared with Avatar.astro and the thread offset below. */
        --avatar-size: 38px;
        --avatar-gap: 0.75rem;
        display: flex;
        gap: var(--avatar-gap);
        border: 1px solid black;
        margin: 0.5rem 0;
        padding: 1rem;
        overflow-wrap: anywhere;
    }

    .content {
        flex: 1;
        min-width: 0;
    }

    .header {
        margin: 0;
        font-size: inherit;
        font-weight: inherit;
    }

    .author {
        padding: 0;
        border: 0;
        background: none;
        font: inherit;
        font-weight: bold;
        color: inherit;
        cursor: pointer;
    }

    .author:hover {
        text-decoration: underline;
    }

    .timestamp {
        color: var(--color-secondary);
    }

    /* Non-breaking space so the dot never ends a line on its own. */
    .timestamp::before {
        content: "·\00a0";
    }

    .message + .message {
        margin-block-start: 1rem;
    }

    /* Rendered message text can contain <blockquote>/<pre>, which a <p> can't
       hold, so these are <div>s with a <p>'s default margins. */
    .text {
        margin-block: 0.25em 0.5em;
    }

    .files-count {
        margin-block: 0.5rem;
        font-size: 0.875em;
        color: var(--color-secondary);
    }

    .files-count + .files {
        margin-block-start: 0;
    }

    .files {
        margin-block: 0.5rem 1rem;
        display: flex;
        flex-wrap: wrap;
        /* Players of different heights would otherwise stretch to the row. */
        align-items: flex-start;
        gap: 1rem;
    }

    /* Holds the edge fades, which would scroll along inside the scroller. */
    .image-row {
        position: relative;
        width: 100%;
    }

    .image-row__scroller {
        overflow-x: auto;
        /* So a swipe at the end isn't taken as back navigation. */
        overscroll-behavior-x: contain;
    }

    /* Edges darken where there's more to scroll. A row that fits has an
       inactive timeline, so they stay hidden. Firefox lacks scroll-driven
       animations so far, and gets no fades. */
    @supports (animation-timeline: scroll()) {
        .image-row {
            --fade: 3rem;
            /* The fades are outside the scroller defining the timeline. */
            timeline-scope: --image-row;
        }

        .image-row__scroller {
            scroll-timeline: --image-row inline;
        }

        .image-row::before,
        .image-row::after {
            content: "";
            position: absolute;
            inset-block: 0;
            width: var(--fade);
            pointer-events: none;
            opacity: 0;
            animation: image-row-fade linear both;
            animation-timeline: --image-row;
        }

        .image-row::before {
            left: 0;
            background: linear-gradient(to right, rgb(0 0 0 / 0.6), transparent);
            animation-range: 0 var(--fade);
        }

        .image-row::after {
            right: 0;
            background: linear-gradient(to left, rgb(0 0 0 / 0.6), transparent);
            animation-range: calc(100% - var(--fade)) 100%;
            animation-direction: reverse;
        }
    }

    @keyframes image-row-fade {
        to { opacity: 1; }
    }

    .image-row__track {
        --gap: 0.5rem;
        display: flex;
        align-items: flex-start;
        gap: var(--gap);
        min-width: calc(var(--ratio-sum) * var(--min-height) + var(--gaps) * var(--gap));
        max-width: calc(var(--ratio-sum) * var(--max-height) + var(--gaps) * var(--gap));
    }

    /* Opens the original, which for a converted image (e.g. HEIC) is the file
       as uploaded rather than the copy shown. Sized by its inline flex-grow
       and aspect-ratio. */
    .image-link {
        flex: 0 1 0;
        min-width: 0;
        line-height: 0;
    }

    /* The border goes inside, keeping heights shared, which puts the box a
       pixel off the image's ratio (as can Slack's thumbnail rounding): cover
       crops that rather than letterboxing it. */
    .image {
        box-sizing: border-box;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border: 1px solid black;
    }

    .image--letterboxed {
        object-fit: contain;
    }

    /* Capped in both directions, keeping the aspect ratio, so a tall portrait
       video doesn't take over the channel (Slack caps around the same).
       Videos with known dimensions already get their capped size as
       width/height attributes (see mediaSize); height: auto keeps the ratio
       when 100% is narrower. Videos without get capped from their natural
       size. */
    .video {
        max-width: min(100%, 480px);
        max-height: 360px;
        height: auto;
        border: 1px solid black;
    }

    /* A player with its file link underneath. The link is the fallback where
       the browser can't play the file (e.g. HEVC video in Firefox), since
       there's no JavaScript to detect that. */
    .player {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        max-width: 100%;
    }

    .audio {
        max-width: 100%;
    }

    .thread__header {
        margin-block: 1rem;
    }

    /* .content is a flex item, so trailing margins don't collapse into the
       group's padding and would add to it. Spacing between messages comes from
       .message + .message instead. */
    .message > :global(:last-child),
    .text > :global(:last-child),
    details:not([open]) > .thread__header,
    .thread > .group:last-child {
        margin-block-end: 0;
    }

    .thread :global(.group) {
        border-left: 0.5rem solid black;
    }

    /* Replies line up under the parent's avatar instead of its text, so nested
       threads don't lose a column of width per level. Each reply keeps its own
       avatar column inside its box. */
    .thread {
        margin-inline-start: calc(-1 * (var(--avatar-size) + var(--avatar-gap)));
    }
</style>

<div class="group">
    <Avatar url={author.authorAvatarUrl} colorKey={author.authorId ?? author.authorDisplayName}
            name={author.authorDisplayName} popoverTarget={profilePopover}/>
    <div class="content">
        <Header class="header" id={headerId}>
            {profilePopover ? (
                <button type="button" class="author" title={author.authorRealName} popovertarget={profilePopover}>{author.authorDisplayName}</button>
            ) : (
                <b title={author.authorRealName}>{author.authorDisplayName}</b>
            )}
            <time class="timestamp" datetime={author.timestamp}>{renderTimestamp(author.timestamp)}</time>
        </Header>
        {messages.map((message) => {
            const row = imageRow(message.files);
            return (
                <div class="message">
                    {message.text && <div class="text" set:html={renderMessageText(message.text)}/>}
                    {message.files.length > 1 && (
                        <div class="files-count">{message.files.length} vedlegg</div>
                    )}
                    {message.files.length > 0 && (
                        <div class="files">
                            {row && (
                                <div class="image-row">
                                    <div class="image-row__scroller">
                                        <div class="image-row__track" style={row.style}>
                                            {row.images.map((image) => (
                                                <a href={image.url} target="_blank" rel="noopener noreferrer" class="image-link"
                                                   style={{"flex-grow": image.ratio, "aspect-ratio": image.ratio}}>
                                                    <img src={image.src} alt={image.name ?? ""} class:list={["image", {"image--letterboxed": image.letterboxed}]}
                                                         loading="lazy" decoding="async"/>
                                                </a>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            )}
                            {message.files.filter((file) => file.embed?.kind !== "image").map((file) => {
                                const link = (
                                    <a href={file.url} target="_blank" rel="noopener noreferrer">
                                        {file.name ?? file.id}
                                    </a>
                                );
                                switch (file.embed?.kind) {
                                    case "video":
                                        return (
                                            <div class="player">
                                                <video src={file.embed.url} controls class="video" {...videoPreview(file.embed)} {...mediaSize(file.embed)}/>
                                                {link}
                                            </div>
                                        );
                                    case "audio":
                                        return (
                                            <div class="player">
                                                <audio src={file.embed.url} controls preload="metadata" class="audio"/>
                                                {link}
                                            </div>
                                        );
                                    default:
                                        return link;
                                }
                            })}
                        </div>
                    )}
                    <Reactions messageId={message.id} reactions={message.reactions}/>
                    {message.replies.length > 0 && (
                        <details>
                            <summary class="thread__header">
                                {message.replies.length} svar
                            </summary>
                            <div class="thread">
                                {groupMessages(message.replies).map((group) => (
                                    <Astro.self messages={group} inThread/>
                                ))}
                            </div>
                        </details>
                    )}
                </div>
            );
        })}
    </div>
</div>

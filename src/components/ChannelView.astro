---
import { renderMessageText } from "../lib/renderMessageText";

const { channelId } = Astro.props;

const backendUrl = process.env.BACKEND_URL;

const response = await fetch(`${backendUrl}/channels/${channelId}`);

type FileResponse = {
	id: string;
	name: string | null;
	mimetype: string | null;
	url: string;
};

type MessageResponse = {
	id: string;
	text: string | null;
	authorName: string;
	files: FileResponse[];
	replies: MessageResponse[];
};

type ChannelResponse = {
	channel: { id: string; name: string; topic: string | null };
	messages: MessageResponse[];
};

const data = response.ok ? (await response.json() as ChannelResponse) : null;
---

<a href="/">&larr; slackopy</a>
{data ? (
	<>
		<h1>#{data.channel.name}</h1>
		{data.channel.topic && <p set:html={renderMessageText(data.channel.topic)} />}
		<ul>
			{data.messages.map((message) => (
				<li>
					<p>{message.authorName}</p>
					{message.text && <p set:html={renderMessageText(message.text)} />}
					{message.files.map((file) => (
						file.mimetype?.startsWith("image/") ? (
							<img src={file.url} alt={file.name ?? ""} style="max-width: min(100%, 480px); height: auto;" />
						) : (
							<a href={file.url} target="_blank" rel="noopener noreferrer">
								{file.name ?? file.id}
							</a>
						)
					))}
					{message.replies.length > 0 && (
						<ul>
							{message.replies.map((reply) => (
								<li>
									<p>{reply.authorName}</p>
									{reply.text && <p set:html={renderMessageText(reply.text)} />}
									{reply.files.map((file) => (
										file.mimetype?.startsWith("image/") ? (
											<img src={file.url} alt={file.name ?? ""} style="max-width: min(100%, 480px); height: auto;" />
										) : (
											<a href={file.url} target="_blank" rel="noopener noreferrer">
												{file.name ?? file.id}
											</a>
										)
									))}
								</li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
	</>
) : (
	<p>Channel not found.</p>
)}

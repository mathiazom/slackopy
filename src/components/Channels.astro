---
import {channelHref} from "../lib/channelUrl";

const backendUrl = process.env.BACKEND_URL;

const response = await fetch(`${backendUrl}/channels`);
if (!response.ok) {
	throw new Error(`Fetching channels failed: ${response.status}`);
}
const data = await response.json();
const channels = data.channels as {id: string, name: string}[];

const statsResponse = await fetch(`${backendUrl}/stats`);
if (!statsResponse.ok) {
	throw new Error(`Fetching stats failed: ${statsResponse.status}`);
}
const stats = await statsResponse.json() as {
	messageCount: number,
	firstMessage: string | null,
	lastMessage: string | null,
};

// Set by the image build, absent in dev.
const commit = process.env.GIT_COMMIT;

function renderDate(timestamp: string) {
	return new Date(timestamp).toLocaleDateString(new Intl.Locale('no'), {dateStyle: "medium"});
}
---
<style>
	/* Search runs in the browser, so without JS the box would lead nowhere. */
	@media (scripting: none) {
		.search {
			display: none;
		}
	}
</style>
<!-- A plain form: /search runs the query from ?q=. Styled like the search page's
     input. -->
<form class="search" action="/search/" style="padding: 1rem 1rem 0;">
	<input type="search" name="q" placeholder="Søk" aria-label="Søk"
		   style="width: 100%; box-sizing: border-box; height: 36px; padding: 0 10px; border: 1px solid black; border-radius: 0; font: inherit; font-size: 16px; color: black;"/>
</form>
<ul style="display: flex; flex-direction: column; list-style: none; padding: 1rem; margin: 0; font-size: 1.25rem; gap: 1rem;">
	{channels.map((channel) => (
		<li><a href={channelHref(channel.id)}>#{channel.name}</a></li>
	))}
</ul>
<footer style="padding: 1rem; color: var(--color-secondary); font-size: 0.875rem;">
	<p style="margin: 0;">
		{stats.messageCount.toLocaleString(new Intl.Locale('no'))} meldinger i {channels.length} kanaler{stats.firstMessage && stats.lastMessage && `, fra ${renderDate(stats.firstMessage)} til ${renderDate(stats.lastMessage)}`}
	</p>
	<p style="margin: 0;">
		Sist bygget {new Date().toLocaleString(new Intl.Locale('no'), {dateStyle: "medium", timeStyle: "short"})}
		{commit && <> · slackopy <a href={`https://github.com/mathiazom/slackopy/commit/${commit}`} style="color: inherit;">{commit.slice(0, 7)}</a></>}
	</p>
</footer>

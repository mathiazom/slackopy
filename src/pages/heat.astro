---
import Layout from "../layouts/Layout.astro";
import "../styles/popover.css";

const backendUrl = process.env.BACKEND_URL;

// Days are bucketed in the build's time zone, like every other date on the site.
const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
const response = await fetch(`${backendUrl}/activity?tz=${encodeURIComponent(timeZone)}`);
if (!response.ok) {
	throw new Error(`Fetching activity failed: ${response.status}`);
}
type Day = {date: string, count: number, users: number};
const {days} = await response.json() as {days: Day[]};
const byDate = new Map(days.map((day) => [day.date, day]));

// Dates are calendar days, handled as UTC midnights so DST never shifts them.
const DAY = 24 * 60 * 60 * 1000;
const parse = (date: string) => new Date(`${date}T00:00:00Z`);
const key = (date: Date) => date.toISOString().slice(0, 10);
const monday = (date: Date) => new Date(date.getTime() - ((date.getUTCDay() + 6) % 7) * DAY);

// "sv" formats as YYYY-MM-DD.
const today = parse(new Date().toLocaleDateString("sv"));
const first = days.length > 0 ? parse(days[0].date) : today;

// Shades by quartile of the active days, so a few huge days don't wash out the
// rest. Level 0 is a day without messages.
const sorted = days.map((day) => day.count).sort((a, b) => a - b);
const quartiles = [0.25, 0.5, 0.75].map((q) => sorted[Math.floor(q * (sorted.length - 1))] ?? 0);
function level(count: number) {
	if (count === 0) return 0;
	return 1 + quartiles.filter((quartile) => count > quartile).length;
}

function describe(date: Date, count: number, users: number) {
	return [
		date.toLocaleDateString("nb", {weekday: "short", day: "numeric", month: "short", year: "numeric", timeZone: "UTC"}),
		`${count.toLocaleString("nb")} ${count === 1 ? "melding" : "meldinger"}`,
		`${users.toLocaleString("nb")} ${users === 1 ? "aktiv bruker" : "aktive brukere"}`,
	];
}

// Newest week first. A month is labelled on its newest week, so the label heads
// its block when scrolling down. A year is labelled on the week of 1 January,
// where it starts.
type Cell = {date: Date, count: number, users: number} | null;
const weeks: {year: number | null, month: string | null, cells: Cell[]}[] = [];
let labelled: string | null = null;
for (let start = monday(today); start >= monday(first); start = new Date(start.getTime() - 7 * DAY)) {
	const cells = Array.from({length: 7}, (_, i): Cell => {
		const date = new Date(start.getTime() + i * DAY);
		if (date > today || date < first) return null;
		const day = byDate.get(key(date));
		return {date, count: day?.count ?? 0, users: day?.users ?? 0};
	});
	const shown = weeks.length === 0 ? (cells.findLast((cell) => cell) as {date: Date}).date : start;
	const month = key(shown).slice(0, 7);
	const sunday = new Date(start.getTime() + 6 * DAY);
	const year = sunday.getUTCDate() <= 7 && sunday.getUTCMonth() === 0 ? sunday.getUTCFullYear() : null;
	let label = null;
	if (month !== labelled) {
		labelled = month;
		label = shown.toLocaleDateString("nb", {month: "short", timeZone: "UTC"});
	}
	weeks.push({year, month: label, cells});
}
---
<Layout>
	<style>
		.heat {
			display: grid;
			grid-template-columns: max-content max-content repeat(7, 28px);
			gap: 4px;
			align-items: center;
			font-size: 0.875rem;
			color: var(--color-secondary);
		}

		.label {
			padding-right: 0.5rem;
			white-space: nowrap;
		}

		.day {
			display: block;
			width: 100%;
			height: 28px;
			padding: 0;
			border: none;
			cursor: pointer;
		}

		.day-popover ul {
			margin: 0;
			padding: 0;
			list-style-type: none;
		}

		.level-0 { background: #ebedf0; }
		.level-1 { background: #fde68a; }
		.level-2 { background: #f59e0b; }
		.level-3 { background: #dc2626; }
		.level-4 { background: #7f1d1d; }
	</style>
	<div style="display: flex; flex-direction: column; gap: 1rem; padding: 1rem;">
		<a href="/">&larr; kanaler</a>
		<div class="heat">
			{weeks.map((week) => (
				<>
					<span class="label">{week.year}</span>
					<span class="label">{week.month}</span>
					{week.cells.map((cell) => {
						if (!cell) return <span></span>;
						// Tapped rather than hovered, so it works on touch too.
						const id = `day-${key(cell.date)}`;
						const lines = describe(cell.date, cell.count, cell.users);
						return (
							<>
								<button type="button" class={`day level-${level(cell.count)}`} popovertarget={id}
										aria-label={lines.join(", ")} style={`anchor-name: --${id}`}></button>
								<div class="popover day-popover" id={id} popover style={`position-anchor: --${id}`}>
									<ul>{lines.map((line) => <li>{line}</li>)}</ul>
								</div>
							</>
						);
					})}
				</>
			))}
		</div>
	</div>
</Layout>
